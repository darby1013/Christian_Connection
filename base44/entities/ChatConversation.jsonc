{
  "name": "ChatConversation",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Chat message history"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "resolved",
        "escalated"
      ],
      "default": "active"
    },
    "satisfaction_rating": {
      "type": "number"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "user_id"
  ]
}