{
  "name": "KnowledgeBase",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Article title"
    },
    "content": {
      "type": "string",
      "description": "Article content in HTML"
    },
    "excerpt": {
      "type": "string",
      "description": "Short summary"
    },
    "category": {
      "type": "string",
      "enum": [
        "getting_started",
        "faith",
        "ministry",
        "theology",
        "practical",
        "faq"
      ],
      "default": "faq"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "author_id": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "views": {
      "type": "number",
      "default": 0
    },
    "helpful_count": {
      "type": "number",
      "default": 0,
      "description": "How many found this helpful"
    },
    "is_published": {
      "type": "boolean",
      "default": false
    },
    "access_level": {
      "type": "string",
      "enum": [
        "free",
        "members",
        "premium",
        "vip"
      ],
      "default": "free"
    }
  },
  "required": [
    "title",
    "content"
  ]
}