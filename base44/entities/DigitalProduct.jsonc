{
  "name": "DigitalProduct",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "ebook",
        "course",
        "transcript",
        "artwork",
        "music",
        "podcast",
        "flyer",
        "template",
        "other"
      ]
    },
    "price": {
      "type": "number"
    },
    "thumbnail_url": {
      "type": "string"
    },
    "file_url": {
      "type": "string",
      "description": "URL to the digital file"
    },
    "file_size": {
      "type": "string"
    },
    "file_format": {
      "type": "string"
    },
    "preview_url": {
      "type": "string",
      "description": "Preview/sample file URL"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "manual",
        "livestream",
        "podcast",
        "video",
        "generated"
      ],
      "description": "How this digital product was created"
    },
    "source_id": {
      "type": "string",
      "description": "ID of source content (livestream, podcast, etc)"
    },
    "download_count": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "name",
    "category",
    "price",
    "file_url"
  ]
}