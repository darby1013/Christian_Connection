{
  "name": "NotificationTemplate",
  "type": "object",
  "properties": {
    "template_name": {
      "type": "string"
    },
    "template_type": {
      "type": "string",
      "enum": [
        "email",
        "sms",
        "push",
        "in_app"
      ],
      "description": "Type of notification"
    },
    "event_trigger": {
      "type": "string",
      "description": "Event that triggers notification"
    },
    "subject": {
      "type": "string"
    },
    "body": {
      "type": "string",
      "description": "Template body with variables"
    },
    "variables": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Available template variables"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "send_count": {
      "type": "number",
      "default": 0
    },
    "open_rate": {
      "type": "number",
      "description": "Open rate percentage"
    },
    "click_rate": {
      "type": "number"
    }
  },
  "required": [
    "template_name",
    "template_type",
    "body"
  ]
}