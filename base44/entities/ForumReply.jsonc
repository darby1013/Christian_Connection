{
  "name": "ForumReply",
  "type": "object",
  "properties": {
    "thread_id": {
      "type": "string",
      "description": "Reference to ForumThread"
    },
    "reply_text": {
      "type": "string"
    },
    "author_id": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "author_image": {
      "type": "string"
    },
    "upvotes": {
      "type": "number",
      "default": 0
    },
    "is_solution": {
      "type": "boolean",
      "default": false,
      "description": "Marked as solution by thread creator"
    },
    "is_pinned": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "thread_id",
    "reply_text",
    "author_id"
  ]
}