{
  "name": "UserSession",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "ip_address": {
      "type": "string"
    },
    "user_agent": {
      "type": "string"
    },
    "device_type": {
      "type": "string",
      "enum": [
        "desktop",
        "mobile",
        "tablet"
      ]
    },
    "browser": {
      "type": "string"
    },
    "os": {
      "type": "string"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_activity": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "pages_viewed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "actions_performed": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "session_id",
    "user_id"
  ]
}