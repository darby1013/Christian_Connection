{
  "name": "UserBadge",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "badge_id": {
      "type": "string"
    },
    "earned_date": {
      "type": "string",
      "format": "date-time"
    },
    "is_showcased": {
      "type": "boolean",
      "default": false,
      "description": "Whether user displays this badge on profile"
    },
    "showcase_order": {
      "type": "number",
      "description": "Order in profile showcase (1-5)"
    }
  },
  "required": [
    "user_id",
    "badge_id"
  ]
}