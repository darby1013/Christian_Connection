{
  "name": "GroupChannel",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "Parent group ID"
    },
    "channel_name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "is_private": {
      "type": "boolean",
      "default": false,
      "description": "Private sub-channel"
    },
    "allowed_members": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "User IDs allowed in private channel"
    },
    "post_count": {
      "type": "number",
      "default": 0
    },
    "created_by": {
      "type": "string"
    },
    "icon": {
      "type": "string",
      "description": "Channel icon/emoji"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "group_id",
    "channel_name"
  ]
}