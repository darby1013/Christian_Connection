{
  "name": "PaymentGatewayConfig",
  "type": "object",
  "properties": {
    "gateway_name": {
      "type": "string",
      "enum": [
        "stripe",
        "paypal",
        "square",
        "apple_pay",
        "google_pay",
        "cashapp"
      ]
    },
    "display_name": {
      "type": "string"
    },
    "is_enabled": {
      "type": "boolean",
      "default": false
    },
    "is_test_mode": {
      "type": "boolean",
      "default": true
    },
    "api_key": {
      "type": "string",
      "description": "Encrypted API key"
    },
    "secret_key": {
      "type": "string",
      "description": "Encrypted secret key"
    },
    "merchant_id": {
      "type": "string",
      "description": "Merchant/Client ID for OAuth gateways"
    },
    "supported_currencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "transaction_fee_percentage": {
      "type": "number"
    }
  },
  "required": [
    "gateway_name",
    "display_name"
  ]
}