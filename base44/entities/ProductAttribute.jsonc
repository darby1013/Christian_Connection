{
  "name": "ProductAttribute",
  "type": "object",
  "properties": {
    "attribute_type": {
      "type": "string",
      "enum": [
        "brand",
        "cut",
        "style",
        "fabric_material",
        "fabric_weight",
        "size",
        "color",
        "special"
      ],
      "description": "Type of attribute"
    },
    "name": {
      "type": "string",
      "description": "Attribute name"
    },
    "slug": {
      "type": "string",
      "description": "URL-friendly slug"
    },
    "display_order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "parent_id": {
      "type": "string",
      "description": "Parent attribute for hierarchical structure"
    },
    "metadata": {
      "type": "object",
      "description": "Additional data (color hex, size chart, etc.)"
    }
  },
  "required": [
    "attribute_type",
    "name"
  ]
}