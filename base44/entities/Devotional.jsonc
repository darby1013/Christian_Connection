{
  "name": "Devotional",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "scripture_reference": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "devotional_date": {
      "type": "string",
      "format": "date"
    },
    "image_url": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "views": {
      "type": "number",
      "default": 0
    },
    "shares": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "content"
  ]
}