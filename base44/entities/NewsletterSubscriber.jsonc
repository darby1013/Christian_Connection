{
  "name": "NewsletterSubscriber",
  "type": "object",
  "properties": {
    "email": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "subscribed_date": {
      "type": "string",
      "format": "date-time"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "preferences": {
      "type": "object"
    },
    "unsubscribed_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "email"
  ]
}