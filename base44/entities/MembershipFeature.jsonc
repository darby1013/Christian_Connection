{
  "name": "MembershipFeature",
  "type": "object",
  "properties": {
    "feature_name": {
      "type": "string",
      "description": "Feature identifier"
    },
    "display_name": {
      "type": "string",
      "description": "User-friendly name"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "content",
        "community",
        "commerce",
        "communication",
        "exclusive"
      ],
      "default": "community"
    },
    "free_tier_enabled": {
      "type": "boolean",
      "default": true
    },
    "basic_tier_enabled": {
      "type": "boolean",
      "default": true
    },
    "premium_tier_enabled": {
      "type": "boolean",
      "default": true
    },
    "vip_tier_enabled": {
      "type": "boolean",
      "default": true
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "icon": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "feature_name",
    "display_name"
  ]
}