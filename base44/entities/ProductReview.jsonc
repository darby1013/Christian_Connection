{
  "name": "ProductReview",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "review_text": {
      "type": "string"
    },
    "verified_purchase": {
      "type": "boolean",
      "default": false
    },
    "helpful_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "product_id",
    "user_id",
    "rating"
  ]
}