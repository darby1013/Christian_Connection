{
  "name": "Event",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date-time"
    },
    "end_date": {
      "type": "string",
      "format": "date-time"
    },
    "location": {
      "type": "string"
    },
    "is_online": {
      "type": "boolean",
      "default": false
    },
    "meeting_url": {
      "type": "string"
    },
    "organizer_name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "attendee_count": {
      "type": "number",
      "default": 0
    },
    "max_attendees": {
      "type": "number"
    },
    "registration_required": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "upcoming",
        "ongoing",
        "completed",
        "cancelled"
      ],
      "default": "upcoming"
    }
  },
  "required": [
    "title",
    "start_date"
  ]
}