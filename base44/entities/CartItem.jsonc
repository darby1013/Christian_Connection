{
  "name": "CartItem",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "User ID who owns this cart item"
    },
    "product_id": {
      "type": "string",
      "description": "Product ID"
    },
    "quantity": {
      "type": "number",
      "default": 1
    },
    "variant": {
      "type": "string",
      "description": "Selected variant (size, color, etc.)"
    },
    "price": {
      "type": "number",
      "description": "Price at time of adding to cart"
    }
  },
  "required": [
    "user_id",
    "product_id",
    "quantity"
  ]
}