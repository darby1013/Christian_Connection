{
  "name": "SystemBackup",
  "type": "object",
  "properties": {
    "backup_name": {
      "type": "string"
    },
    "backup_type": {
      "type": "string",
      "enum": [
        "full",
        "incremental",
        "files",
        "database"
      ]
    },
    "file_url": {
      "type": "string"
    },
    "size_gb": {
      "type": "number"
    },
    "created_date": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "failed",
        "in_progress"
      ]
    },
    "can_restore": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "backup_name",
    "backup_type"
  ]
}