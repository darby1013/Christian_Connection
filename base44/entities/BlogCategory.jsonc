{
  "name": "BlogCategory",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Category name"
    },
    "slug": {
      "type": "string",
      "description": "URL-friendly identifier"
    },
    "description": {
      "type": "string"
    },
    "icon": {
      "type": "string",
      "description": "Icon or emoji"
    },
    "color": {
      "type": "string",
      "description": "Hex color code"
    },
    "post_count": {
      "type": "number",
      "default": 0,
      "description": "Number of posts in category"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "slug"
  ]
}