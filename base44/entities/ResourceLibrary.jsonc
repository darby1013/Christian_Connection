{
  "name": "ResourceLibrary",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "resource_type": {
      "type": "string",
      "enum": [
        "document",
        "video",
        "audio",
        "ebook",
        "course",
        "template"
      ],
      "default": "document"
    },
    "file_url": {
      "type": "string"
    },
    "thumbnail_url": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "access_level": {
      "type": "string",
      "enum": [
        "free",
        "members",
        "premium",
        "vip"
      ],
      "default": "free"
    },
    "downloads": {
      "type": "number",
      "default": 0
    },
    "views": {
      "type": "number",
      "default": 0
    },
    "rating": {
      "type": "number",
      "default": 0
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "author_id": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "resource_type"
  ]
}