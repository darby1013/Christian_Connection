{
  "name": "DirectMessage",
  "type": "object",
  "properties": {
    "sender_id": {
      "type": "string"
    },
    "sender_name": {
      "type": "string"
    },
    "recipient_id": {
      "type": "string"
    },
    "recipient_name": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "conversation_id": {
      "type": "string",
      "description": "Groups messages between two users"
    },
    "attachment_url": {
      "type": "string"
    }
  },
  "required": [
    "sender_id",
    "recipient_id",
    "message"
  ]
}