{
  "name": "UserBadgeShowcase",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Unique per user"
    },
    "showcased_badges": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of UserBadge IDs to display"
    },
    "max_showcase_slots": {
      "type": "number",
      "default": 6,
      "description": "Maximum badges that can be showcased"
    },
    "layout_style": {
      "type": "string",
      "enum": [
        "grid",
        "horizontal",
        "featured"
      ],
      "default": "grid"
    }
  },
  "required": [
    "user_id"
  ]
}