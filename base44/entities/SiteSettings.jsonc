{
  "name": "SiteSettings",
  "type": "object",
  "properties": {
    "setting_key": {
      "type": "string",
      "description": "Unique identifier for the setting"
    },
    "setting_value": {
      "type": "string",
      "description": "Value of the setting"
    },
    "setting_type": {
      "type": "string",
      "enum": [
        "text",
        "url",
        "video",
        "image",
        "json"
      ],
      "description": "Type of setting"
    },
    "category": {
      "type": "string",
      "enum": [
        "hero",
        "theme",
        "general",
        "seo",
        "social"
      ],
      "description": "Setting category"
    },
    "description": {
      "type": "string",
      "description": "Description of what this setting controls"
    }
  },
  "required": [
    "setting_key",
    "setting_value"
  ]
}