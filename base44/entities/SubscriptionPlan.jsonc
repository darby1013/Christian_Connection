{
  "name": "SubscriptionPlan",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Plan name"
    },
    "tier": {
      "type": "string",
      "enum": [
        "basic",
        "premium",
        "vip"
      ],
      "default": "basic"
    },
    "price": {
      "type": "number",
      "description": "Monthly price"
    },
    "billing_period": {
      "type": "string",
      "enum": [
        "monthly",
        "quarterly",
        "yearly"
      ],
      "default": "monthly"
    },
    "description": {
      "type": "string"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "max_streams": {
      "type": "number",
      "description": "Maximum concurrent streams, -1 for unlimited"
    },
    "exclusive_content": {
      "type": "boolean",
      "default": false
    },
    "early_access": {
      "type": "boolean",
      "default": false
    },
    "ad_free": {
      "type": "boolean",
      "default": false
    },
    "custom_badge": {
      "type": "string",
      "description": "Special badge for subscribers"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "tier",
    "price"
  ]
}