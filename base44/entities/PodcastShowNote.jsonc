{
  "name": "PodcastShowNote",
  "type": "object",
  "properties": {
    "podcast_id": {
      "type": "string",
      "description": "Reference to Podcast entity"
    },
    "summary": {
      "type": "string",
      "description": "AI-generated episode summary"
    },
    "key_points": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Main takeaways"
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "timestamps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "time": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      },
      "description": "Chapter markers"
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "is_auto_generated": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "podcast_id",
    "summary"
  ]
}