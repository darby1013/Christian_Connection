{
  "name": "LandingPage",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "content": {
      "type": "object",
      "description": "JSON content blocks"
    },
    "hero_image": {
      "type": "string"
    },
    "cta_text": {
      "type": "string"
    },
    "cta_link": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "views": {
      "type": "number",
      "default": 0
    },
    "conversions": {
      "type": "number",
      "default": 0
    },
    "seo_title": {
      "type": "string"
    },
    "seo_description": {
      "type": "string"
    }
