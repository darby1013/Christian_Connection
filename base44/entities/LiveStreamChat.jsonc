{
  "name": "LiveStreamChat",
  "type": "object",
  "properties": {
    "stream_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "user_image": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "text",
        "emoji",
        "gif",
        "sticker"
      ],
      "default": "text"
    },
    "is_pinned": {
      "type": "boolean",
      "default": false
    },
    "is_moderator": {
      "type": "boolean",
      "default": false
    },
    "reactions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "mentions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "stream_id",
    "user_id",
    "message"
  ]
}