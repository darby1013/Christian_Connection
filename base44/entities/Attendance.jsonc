      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "attendance_date": {
      "type": "string",
      "format": "date"
    },
    "check_in_time": {
      "type": "string",
      "format": "date-time"
    },
    "check_out_time": {
      "type": "string",
      "format": "date-time"
    },
    "attendance_type": {
      "type": "string",
